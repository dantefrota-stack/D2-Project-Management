{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "d2-project-management",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".firebase/**",
      ".vscode/**",
      ".idea/**",
      "functions/**",
      "tests/**",
      "firestore.rules",
      "storage.rules",
      "**/node_modules/**",
      "**/.env",
      "**/.env.*",
      "**/*.key",
      "**/*.pem",
      "**/*.log",
      "**/*.local"
    ],
    "rewrites": [
      {
        "source": "/api/admin",
        "function": {
          "functionId": "adminApi",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/portal-sso",
        "function": {
          "functionId": "portalSso",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/contractor-documents",
        "function": {
          "functionId": "contractorDocuments",
          "region": "us-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://d2-group-system.web.app" },
          { "key": "Referrer-Policy", "value": "same-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
