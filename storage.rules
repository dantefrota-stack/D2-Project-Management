rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Contractor documents are handled exclusively by verified Cloud Functions.
    // Client-side reads and writes are denied, including authenticated users.
    match /contractor_documents/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
