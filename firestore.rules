rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/artifacts/d2-Project-Management/public/data/access_control/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath()) && get(accessPath()).data.active == true
        && (!portalBridge() || (request.auth.token.get('portal_bridge', false) == true
          && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'custom'
          && request.auth.token.get('portal_until', 0) is int
          && request.time.toMillis() < request.auth.token.portal_until * 1000));
    }

    function portalBridge() {
      return request.auth.token.get('portal_bridge', false) == true
        || request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'custom';
    }

    function portalAction(action) {
      return !portalBridge() || (action in request.auth.token.get('portal_actions', [])
        && (!request.auth.token.get('portal_report_all', false) || action in ['read', 'read_cost', 'export']));
    }

    function access() {
      return get(accessPath()).data;
    }

    function isSuperAdmin() {
      // Callers check hasAccess once. Repeating it in every nested company/field
      // check can exhaust Firestore's expression limit on valid updates.
      return access().superAdmin == true && (!portalBridge() || (
        request.auth.token.get('portal_owner', false) == true
        && request.auth.token.get('portal_report_all', false) != true
        && request.auth.uid == 'IYz2jpQojuRsClIHpSaSIFziAQG3'
        && request.auth.token.email == 'dante.frota@allcablingtech.com'
        && request.auth.token.get('portal_scope', '') == 'company'
        && request.auth.token.get('portal_actions', []).hasAll(['read', 'read_cost', 'create', 'edit', 'assign', 'export'])
      ));
    }

    function companyAllowed(company) {
      return companyAllowedWithAdmin(company, isSuperAdmin());
    }

    function companyAllowedWithAdmin(company, administrator) {
      return (!portalBridge() || administrator || (request.auth.token.get('portal_report_all', false) == true && access().superAdmin == true && request.auth.token.portal_actions.hasOnly(['read', 'read_cost', 'export']))
        || (company == 'HVAC' && request.auth.token.portal_company == 'hvac') || (company == 'Smart Home' && request.auth.token.portal_company == 'smart'))
        && (administrator
          || (company == 'HVAC' && access().p_hvac == true)
          || (company == 'Smart Home' && access().p_smart == true));
    }

    function projectReadable(data) {
      return projectReadableWithAdmin(data, isSuperAdmin());
    }

    function projectReadableWithAdmin(data, administrator) {
      return (!portalBridge() || portalAction('read_cost')) && companyAllowedWithAdmin(data.empresa, administrator)
        && (administrator || (access().p_global == true && (!portalBridge() || request.auth.token.portal_scope == 'company')) || data.vendedor == request.auth.token.email);
    }

    function contractorCompanyAllowed(data) {
      return isSuperAdmin()
        || (access().p_contractors == true && (
          (access().p_hvac == true && (data.company == 'HVAC' || ('HVAC' in data.companies)))
          || (access().p_smart == true && (data.company == 'Smart Home' || ('Smart Home' in data.companies)))
        ));
    }

    function validAmounts(data) {
      return data.valorTotal is number && data.valorTotal >= 0 && data.valorTotal <= 1000000000000
        && data.get('orcamento', 0) is number && data.get('orcamento', 0) >= 0 && data.get('orcamento', 0) <= 1000000000000
        && data.get('percComissao', 0) is number && data.get('percComissao', 0) >= 0 && data.get('percComissao', 0) <= 100;
    }

    function boundedText(data, key, limit) {
      return data.get(key, '') is string && data.get(key, '').size() <= limit;
    }

    function validContractor(data) {
      return data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 160
        && data.get('companies', []) is list && data.get('companies', []).size() <= 2
        && data.get('companies', []).hasOnly(['HVAC', 'Smart Home'])
        && boundedText(data, 'contactName', 120) && boundedText(data, 'email', 180)
        && boundedText(data, 'phone', 60) && boundedText(data, 'ein', 40)
        && boundedText(data, 'address', 240) && boundedText(data, 'services', 500)
        && data.get('documents', []) is list && data.get('documents', []).size() <= 2000;
    }

    function validContractorPayment(data) {
      return data.company in ['HVAC', 'Smart Home']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000000
        && boundedText(data, 'contractorId', 128) && boundedText(data, 'contractorName', 160)
        && boundedText(data, 'projectId', 128) && boundedText(data, 'projectName', 500)
        && boundedText(data, 'date', 10) && boundedText(data, 'method', 100)
        && boundedText(data, 'note', 2000);
    }

    function validLists(data) {
      return data.get('recebimentos', []) is list && data.get('recebimentos', []).size() <= 2000
        && data.get('pagamentosEfetuados', []) is list && data.get('pagamentosEfetuados', []).size() <= 2000
        && data.get('despesas', []) is list && data.get('despesas', []).size() <= 2000
        && data.get('inventoryExpenses', []) is list && data.get('inventoryExpenses', []).size() <= 2000;
    }

    // Server-managed immutable copies of inventory costs. Clients (including
    // owners) cannot remove/modify these entries through stale expense arrays.
    function inventoryExpensesProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventoryExpenses'])
        && request.resource.data.get('despesas', []).hasAll(resource.data.get('inventoryExpenses', []))
        && request.resource.data.get('despesas', []).removeAll(resource.data.get('inventoryExpenses', [])).size()
          + resource.data.get('inventoryExpenses', []).size() == request.resource.data.get('despesas', []).size();
    }

    function projectUpdateAllowed(administrator) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let financial = ['recebimentos', 'pagamentosEfetuados'];
      let lifecycle = ['status', 'dataConclusao', 'archived', 'commercialStatus', 'archivedReason', 'updatedAt'];
      let metadata = ['numeroProposta', 'numeroInvoice', 'cliente', 'nomeProjeto', 'endereco', 'vendedor', 'valorTotal', 'orcamento', 'metodo', 'percComissao', 'dataInicio', 'dataEntrega'];
      return administrator || (
        request.resource.data.empresa == resource.data.empresa
        && changed.hasOnly(metadata.concat(lifecycle).concat(financial).concat(['despesas']))
        && (!changed.hasAny(metadata) || access().p_tab_new == true)
        && (!changed.hasAny(['vendedor']) || portalAction('assign'))
        && (!changed.hasAny(financial) || access().p_fin == true)
        && (!changed.hasAny(['despesas']) || access().p_costs == true || (access().p_fin == true && changed.hasAny(['pagamentosEfetuados'])))
        && (!changed.hasAny(lifecycle) || access().p_fin == true || access().p_tab_new == true || (access().p_costs == true && changed.hasOnly(['despesas', 'updatedAt'])))
      );
    }

    function projectWriteAllowed() {
      // Evaluate the protected identity once to stay below the Firestore
      // expression limit while checking both old and new company scopes.
      let administrator = isSuperAdmin();
      return projectReadableWithAdmin(resource.data, administrator)
        && projectReadableWithAdmin(request.resource.data, administrator)
        && portalAction('edit') && validAmounts(request.resource.data)
        && validLists(request.resource.data) && inventoryExpensesProtected()
        && projectUpdateAllowed(administrator);
    }

    match /artifacts/d2-Project-Management/public/data/access_control/{uid} {
      allow get: if hasAccess() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /artifacts/d2-Project-Management/public/data/user_credentials/{userId} {
      allow read, write: if false;
    }

    match /artifacts/d2-Project-Management/public/data/projects/{projectId} {
      allow read: if hasAccess() && access().p_tab_proj == true && portalAction('read') && projectReadable(resource.data);
      allow create: if hasAccess() && portalAction('create') && access().p_tab_new == true && projectReadable(request.resource.data)
        && validAmounts(request.resource.data) && validLists(request.resource.data)
        && request.resource.data.get('recebimentos', []).size() == 0
        && request.resource.data.get('pagamentosEfetuados', []).size() == 0
        && request.resource.data.get('despesas', []).size() == 0
        && request.resource.data.get('inventoryExpenses', []).size() == 0
        && (request.resource.data.vendedor == request.auth.token.email || portalAction('assign'));
      allow update: if hasAccess() && projectWriteAllowed();
      allow delete: if hasAccess() && isSuperAdmin();
    }

    match /artifacts/d2-Project-Management/public/data/contractors/{contractorId} {
      allow read: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && contractorCompanyAllowed(resource.data);
      allow create: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && contractorCompanyAllowed(request.resource.data) && validContractor(request.resource.data);
      allow update: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && contractorCompanyAllowed(resource.data) && contractorCompanyAllowed(request.resource.data) && validContractor(request.resource.data);
      allow delete: if hasAccess() && isSuperAdmin();
    }

    match /artifacts/d2-Project-Management/public/data/contractor_payments/{paymentId} {
      allow read: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && companyAllowed(resource.data.company);
      allow create: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && companyAllowed(request.resource.data.company) && validContractorPayment(request.resource.data);
      allow update: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && companyAllowed(resource.data.company) && companyAllowed(request.resource.data.company) && validContractorPayment(request.resource.data);
      allow delete: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && companyAllowed(resource.data.company);
    }

    match /artifacts/d2-Project-Management/public/data/contractor_document_requests/{requestId} {
      allow read: if hasAccess() && (!portalBridge() || isSuperAdmin()) && access().p_contractors == true && companyAllowed(resource.data.company);
      allow write: if false;
    }

    match /artifacts/d2-Project-Management/public/data/audit_logs/{logId} {
      allow read: if hasAccess() && isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
